# Copy to .env before running Docker, or export these when using docker compose.

APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_KEY=

APP_PORT=8080
VITE_PORT=5173

DB_DATABASE=card_nexus
DB_USERNAME=card_nexus
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
DB_PORT=3306

REDIS_PORT=6379

# Run migrations automatically on app container start
RUN_MIGRATIONS=true

LOG_LEVEL=info
